# Copie este arquivo para .env antes de subir os containers.
# Ajuste os valores sensiveis antes de usar em qualquer ambiente real.

POSTGRES_IMAGE_TAG=16-alpine
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_CREDENTIAL_ID=75T88sJeS9BfaHBO
POSTGRES_CREDENTIAL_NAME=Postgres n8n

TRAEFIK_IMAGE_TAG=latest
TRAEFIK_NETWORK=traefik_proxy
SSL_EMAIL=admin@seudominio.com
TRAEFIK_CERT_RESOLVER=mytlschallenge

# Versao estavel fixada para evitar mudancas automaticas em futuras recriacoes.
N8N_IMAGE_TAG=2.22.5
N8N_PUBLIC_PORT=5678
N8N_DOMAIN=n8n.localhost
N8N_HOST=n8n.localhost
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.localhost/
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true
N8N_METRICS=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# Gere uma chave forte com:
# bash scripts/generate-encryption-key.sh
N8N_ENCRYPTION_KEY=troque_por_uma_chave_forte_com_40_ou_mais_caracteres
