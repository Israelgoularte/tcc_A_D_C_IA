# Copie este arquivo para .env antes de subir os containers.
# Ajuste os valores sensiveis antes de usar em qualquer ambiente real.

POSTGRES_IMAGE_TAG=16-alpine
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=troque_esta_senha

# Para ambientes produtivos, prefira fixar uma versao estavel em vez de usar latest.
N8N_IMAGE_TAG=latest
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_SECURE_COOKIE=false

# Gere uma chave forte e mantenha o mesmo valor entre recriacoes do container.
# Exemplo PowerShell:
# -join ((48..57 + 65..90 + 97..122) | Get-Random -Count 40 | ForEach-Object {[char]$_})
N8N_ENCRYPTION_KEY=troque_por_uma_chave_forte_com_40_ou_mais_caracteres
