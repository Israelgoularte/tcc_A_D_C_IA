    {
      "parameters": {
        "jsCode": "const body = $('obder_dados_atuais_contato').first().json ?? {};\nconst bd = $input.first().json ?? {};\n\nif (body.id === undefined || body.id === null || body.id === '') {\n  throw new Error('O ID do contato não foi informado.');\n}\n\nconst customFields = Array.isArray(body.custom_fields_values)\n  ? body.custom_fields_values\n  : [];\n\nconst normalizar = (valor) => {\n  if (valor === undefined || valor === null || valor === '') {\n    return null;\n  }\n\n  return valor;\n};\n\nconst paraString = (valor) => {\n  const normalizado = normalizar(valor);\n  return normalizado === null ? null : String(normalizado);\n};\n\nconst getCustomField = (...identificadores) => {\n  const normalizarIdentificador = (valor) =>\n    String(valor ?? '').trim().toLowerCase();\n\n  const procurados = identificadores.map(normalizarIdentificador);\n\n  const campo = customFields.find((item) =>\n    [\n      item.field_id,\n      item.field_name,\n      item.field_code,\n    ].some((valor) =>\n      procurados.includes(normalizarIdentificador(valor))\n    )\n  );\n\n  if (!campo || !Array.isArray(campo.values)) {\n    return null;\n  }\n\n  const primeiroValorValido = campo.values\n    .map((item) => normalizar(item?.value))\n    .find((valor) => valor !== null);\n\n  return primeiroValorValido ?? null;\n};\n\nconst timestampParaISO = (valor) => {\n  const normalizado = normalizar(valor);\n\n  if (normalizado === null) {\n    return null;\n  }\n\n  const timestamp = Number(normalizado);\n\n  if (!Number.isFinite(timestamp)) {\n    throw new Error(`Timestamp inválido: ${valor}`);\n  }\n\n  const data = new Date(timestamp * 1000);\n\n  if (Number.isNaN(data.getTime())) {\n    throw new Error(`Data inválida: ${valor}`);\n  }\n\n  return data.toISOString();\n};\n\nconst empresa = body._embedded?.companies?.[0];\n\nconst contato_atualizado = {\n  // Preserva campos internos não fornecidos pela Kommo,\n  // como \"id\" e \"empresa_id\".\n  ...bd,\n\n  id_externo: paraString(body.id),\n  empresa_id_externo: paraString(empresa?.id),\n\n  nome: normalizar(body.name),\n\n  telefone: paraString(\n    getCustomField('PHONE', 'Phone', 'Telefone', 143732)\n  ),\n\n  email: paraString(\n    getCustomField('EMAIL', 'Email', 'E-mail')\n  ),\n\n  cargo: paraString(\n    getCustomField('POSITION', 'Position', 'Cargo')\n  ),\n\n  criado_em: timestampParaISO(body.created_at),\n  atualizado_em: timestampParaISO(body.updated_at),\n};\n\nreturn contato_atualizado;"
      },
