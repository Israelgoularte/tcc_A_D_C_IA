    {
      "parameters": {
        "jsCode": "const body = $('obder_dados_atuais_lead').first().json ?? {};\nconst bd = $input.first().json ?? {};\n\nif (body.id === undefined || body.id === null || body.id === '') {\n  throw new Error('O ID do lead não foi informado.');\n}\n\nconst customFields = Array.isArray(body.custom_fields_values)\n  ? body.custom_fields_values\n  : [];\n\nconst normalizar = (valor) => {\n  if (valor === undefined || valor === null || valor === '') {\n    return null;\n  }\n\n  return valor;\n};\n\nconst paraString = (valor) => {\n  const normalizado = normalizar(valor);\n  return normalizado === null ? null : String(normalizado);\n};\n\nconst getCustomField = (...identificadores) => {\n  const normalizarIdentificador = (valor) =>\n    String(valor ?? '').trim().toLowerCase();\n\n  const procurados = identificadores.map(normalizarIdentificador);\n\n  const campo = customFields.find((item) =>\n    [\n      item.field_id,\n      item.field_name,\n      item.field_code,\n    ].some((valor) =>\n      procurados.includes(normalizarIdentificador(valor))\n    )\n  );\n\n  if (!campo || !Array.isArray(campo.values)) {\n    return null;\n  }\n\n  const valores = campo.values\n    .map((item) => normalizar(item?.value))\n    .filter((valor) => valor !== null);\n\n  if (valores.length === 0) return null;\n  if (valores.length === 1) return valores[0];\n\n  return valores;\n};\n\nconst timestampParaISO = (valor) => {\n  const normalizado = normalizar(valor);\n\n  if (normalizado === null) {\n    return null;\n  }\n\n  const timestamp = Number(normalizado);\n\n  if (!Number.isFinite(timestamp)) {\n    throw new Error(`Timestamp inválido: ${valor}`);\n  }\n\n  const data = new Date(timestamp * 1000);\n\n  if (Number.isNaN(data.getTime())) {\n    throw new Error(`Data inválida: ${valor}`);\n  }\n\n  return data.toISOString();\n};\n\nconst empresa = body._embedded?.companies?.[0];\n\nconst lead_atualizado = {\n  ...bd,\n\n  id_externo: paraString(body.id),\n  empresa_id_externo: paraString(empresa?.id),\n  etapa_id_externo: paraString(body.status_id),\n  funil_id_externo: paraString(body.pipeline_id),\n  usuario_responsavel_id_externo: paraString(\n    body.responsible_user_id\n  ),\n\n  nome: normalizar(body.name),\n\n  venda: normalizar(body.price) === null\n    ? null\n    : Number(body.price),\n\n  utm_source: getCustomField(\n    'UTM_SOURCE',\n    'utm_source',\n    143746\n  ),\n\n  // Mantém a grafia existente da coluna no banco.\n  utm_campaing: getCustomField(\n    'UTM_CAMPAIGN',\n    'utm_campaign',\n    143744\n  ),\n\n  utm_medium: getCustomField(\n    'UTM_MEDIUM',\n    'utm_medium',\n    143742\n  ),\n\n  utm_content: getCustomField(\n    'UTM_CONTENT',\n    'utm_content',\n    143740\n  ),\n\n  servicos: getCustomField(\n    'Serviços',\n    'Servicos',\n    143840\n  ),\n\n  data_contrato: timestampParaISO(\n    getCustomField('Data do Contrato', 143846)\n  ),\n\n  criado_em: timestampParaISO(body.created_at),\n  atualizado_em: timestampParaISO(body.updated_at),\n\n  is_deleted: body.is_deleted === true,\n};\n\nreturn lead_atualizado;"
      },
