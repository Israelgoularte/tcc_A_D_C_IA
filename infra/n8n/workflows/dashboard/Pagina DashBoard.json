    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Dashboard dinâmico</title>\n  <style>\n    :root {\n      color-scheme: light;\n      font-family: Inter, ui-sans-serif, system-ui, -apple-system,\n        BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      --background: #f3f6f5;\n      --surface: #ffffff;\n      --surface-muted: #eaf0ee;\n      --text: #14201d;\n      --muted: #63716d;\n      --border: #d9e3df;\n      --primary: #087f68;\n      --primary-hover: #066a57;\n      --accent: #ec8b2c;\n      --danger: #b42318;\n      --success: #067647;\n      --shadow: 0 8px 24px rgba(20, 32, 29, 0.08);\n    }\n\n    * {\n      box-sizing: border-box;\n    }\n\n    html {\n      scroll-behavior: smooth;\n    }\n\n    body {\n      min-width: 320px;\n      min-height: 100vh;\n      margin: 0;\n      color: var(--text);\n      background: var(--background);\n    }\n\n    button,\n    input {\n      font: inherit;\n    }\n\n    button {\n      cursor: pointer;\n    }\n\n    .app-header {\n      position: sticky;\n      top: 0;\n      z-index: 20;\n      color: #ffffff;\n      background: #103f37;\n      border-bottom: 4px solid var(--accent);\n      box-shadow: 0 4px 14px rgba(20, 32, 29, 0.18);\n    }\n\n    .header-inner,\n    .shell {\n      width: min(1280px, calc(100% - 32px));\n      margin: 0 auto;\n    }\n\n    .header-inner {\n      min-height: 72px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 20px;\n    }\n\n    .brand h1 {\n      margin: 0;\n      font-size: 1.18rem;\n      letter-spacing: 0;\n    }\n\n    .brand p {\n      margin: 4px 0 0;\n      color: #cfe1dc;\n      font-size: 0.8rem;\n    }\n\n    .header-actions {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n    }\n\n    .status {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      color: #d9ebe6;\n      font-size: 0.82rem;\n    }\n\n    .status-dot {\n      width: 9px;\n      height: 9px;\n      background: #98a2a0;\n      border-radius: 50%;\n    }\n\n    .status[data-state=\"online\"] .status-dot {\n      background: #47cd89;\n      box-shadow: 0 0 0 4px rgba(71, 205, 137, 0.18);\n    }\n\n    .status[data-state=\"error\"] .status-dot {\n      background: #f97066;\n    }\n\n    .reload-button {\n      width: 38px;\n      height: 38px;\n      display: grid;\n      place-items: center;\n      color: #ffffff;\n      background: rgba(255, 255, 255, 0.1);\n      border: 1px solid rgba(255, 255, 255, 0.2);\n      border-radius: 6px;\n    }\n\n    .reload-button:hover {\n      background: rgba(255, 255, 255, 0.18);\n    }\n\n    .shell {\n      display: grid;\n      grid-template-columns: 250px minmax(0, 1fr);\n      gap: 20px;\n      padding: 22px 0 48px;\n    }\n\n    .sidebar {\n      position: sticky;\n      top: 94px;\n      align-self: start;\n      max-height: calc(100vh - 116px);\n      overflow-y: auto;\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      box-shadow: var(--shadow);\n    }\n\n    .sidebar-header {\n      padding: 16px;\n      border-bottom: 1px solid var(--border);\n    }\n\n    .sidebar-header h2 {\n      margin: 0;\n      font-size: 0.92rem;\n    }\n\n    .sidebar-header p {\n      margin: 5px 0 0;\n      color: var(--muted);\n      font-size: 0.75rem;\n    }\n\n    .section-nav {\n      display: grid;\n      gap: 4px;\n      padding: 9px;\n    }\n\n    .section-link {\n      width: 100%;\n      padding: 10px;\n      display: grid;\n      gap: 3px;\n      color: var(--text);\n      text-align: left;\n      background: transparent;\n      border: 0;\n      border-radius: 5px;\n    }\n\n    .section-link:hover {\n      background: var(--surface-muted);\n    }\n\n    .section-link strong {\n      font-size: 0.83rem;\n    }\n\n    .section-link span {\n      overflow: hidden;\n      color: var(--muted);\n      font-size: 0.72rem;\n      text-overflow: ellipsis;\n      white-space: nowrap;\n    }\n\n    .content {\n      min-width: 0;\n    }\n\n    .configuration {\n      display: grid;\n      grid-template-columns: minmax(240px, 1fr) auto;\n      gap: 12px;\n      align-items: end;\n      margin-bottom: 16px;\n      padding: 16px;\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      box-shadow: var(--shadow);\n    }\n\n    label {\n      display: grid;\n      gap: 6px;\n      color: var(--muted);\n      font-size: 0.78rem;\n      font-weight: 650;\n    }\n\n    input {\n      width: 100%;\n      height: 40px;\n      padding: 0 11px;\n      color: var(--text);\n      background: #ffffff;\n      border: 1px solid #b9c9c4;\n      border-radius: 6px;\n      outline: none;\n    }\n\n    input:focus {\n      border-color: var(--primary);\n      box-shadow: 0 0 0 3px rgba(8, 127, 104, 0.13);\n    }\n\n    .primary-button {\n      height: 40px;\n      padding: 0 16px;\n      color: #ffffff;\n      font-weight: 700;\n      background: var(--primary);\n      border: 0;\n      border-radius: 6px;\n    }\n\n    .primary-button:hover {\n      background: var(--primary-hover);\n    }\n\n    .primary-button:disabled,\n    .reload-button:disabled {\n      opacity: 0.58;\n      cursor: wait;\n    }\n\n    .feedback {\n      min-height: 22px;\n      margin: 0 2px 10px;\n      color: var(--muted);\n      font-size: 0.84rem;\n    }\n\n    .feedback.error {\n      color: var(--danger);\n    }\n\n    .feedback.success {\n      color: var(--success);\n    }\n\n    .dashboard-sections {\n      display: grid;\n      gap: 18px;\n    }\n\n    .section-frame {\n      min-width: 0;\n      overflow: hidden;\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      box-shadow: var(--shadow);\n    }\n\n    .section-frame-header {\n      padding: 13px 16px;\n      border-bottom: 1px solid var(--border);\n      background: #f9fbfa;\n    }\n\n    .section-frame-header h2 {\n      margin: 0;\n      font-size: 0.92rem;\n    }\n\n    .section-frame-header p {\n      margin: 4px 0 0;\n      color: var(--muted);\n      font-size: 0.76rem;\n    }\n\n    .section-frame-content {\n      min-width: 0;\n    }\n\n    .section-frame-content > section {\n      width: 100%;\n      margin: 0;\n    }\n\n    .state-box {\n      padding: 48px 22px;\n      color: var(--muted);\n      text-align: center;\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      box-shadow: var(--shadow);\n    }\n\n    .state-box strong {\n      display: block;\n      margin-bottom: 7px;\n      color: var(--text);\n    }\n\n    @media (max-width: 900px) {\n      .shell {\n        grid-template-columns: 1fr;\n      }\n\n      .sidebar {\n        position: static;\n        max-height: none;\n      }\n\n      .section-nav {\n        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n      }\n\n      .configuration {\n        grid-template-columns: 1fr 1fr;\n      }\n\n      .primary-button {\n        grid-column: 1 / -1;\n      }\n    }\n\n    @media (max-width: 600px) {\n      .header-inner,\n      .shell {\n        width: min(100% - 20px, 1280px);\n      }\n\n      .brand p,\n      .status span:last-child {\n        display: none;\n      }\n\n      .shell {\n        padding-top: 14px;\n      }\n\n      .configuration {\n        grid-template-columns: 1fr;\n      }\n\n      .primary-button {\n        grid-column: auto;\n      }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      * {\n        scroll-behavior: auto !important;\n        transition-duration: 0.01ms !important;\n      }\n    }\n  </style>\n</head>\n<body>\n  <header class=\"app-header\">\n    <div class=\"header-inner\">\n      <div class=\"brand\">\n        <h1>Dashboard de análise</h1>\n        <p>Seções dinâmicas armazenadas no banco de dados</p>\n      </div>\n      <div class=\"header-actions\">\n        <div class=\"status\" id=\"connectionStatus\" data-state=\"idle\">\n          <span class=\"status-dot\" aria-hidden=\"true\"></span>\n          <span id=\"connectionText\">Aguardando configuração</span>\n        </div>\n        <button\n          class=\"reload-button\"\n          id=\"reloadButton\"\n          type=\"button\"\n          title=\"Recarregar seções\"\n          aria-label=\"Recarregar seções\"\n        >↻</button>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"shell\">\n    <aside class=\"sidebar\">\n      <header class=\"sidebar-header\">\n        <h2>Seções disponíveis</h2>\n        <p id=\"sectionCount\">Nenhuma seção carregada</p>\n      </header>\n      <nav class=\"section-nav\" id=\"sectionNav\" aria-label=\"Seções do dashboard\">\n        <div class=\"state-box\">Configure o acesso para começar.</div>\n      </nav>\n    </aside>\n\n    <div class=\"content\">\n      <section class=\"configuration\" aria-label=\"Configuração das APIs\">\n        <label>\n          URL base do n8n\n          <input\n            id=\"n8nBaseUrl\"\n            type=\"url\"\n            value=\"https://SEU_DOMINIO\"\n            autocomplete=\"url\"\n          >\n        </label>\n        <button class=\"primary-button\" id=\"loadButton\" type=\"button\">\n          Carregar dashboard\n        </button>\n      </section>\n\n      <div class=\"feedback\" id=\"feedback\" role=\"status\" aria-live=\"polite\"></div>\n\n      <div class=\"dashboard-sections\" id=\"dashboardSections\">\n        <div class=\"state-box\">\n          <strong>Dashboard ainda não carregado</strong>\n          Informe a URL do n8n para carregar as seções.\n        </div>\n      </div>\n    </div>\n  </main>\n\n  <script>\n    \"use strict\";\n\n    const elements = {\n      n8nBaseUrl: document.querySelector(\"#n8nBaseUrl\"),\n      loadButton: document.querySelector(\"#loadButton\"),\n      reloadButton: document.querySelector(\"#reloadButton\"),\n      feedback: document.querySelector(\"#feedback\"),\n      connectionStatus: document.querySelector(\"#connectionStatus\"),\n      connectionText: document.querySelector(\"#connectionText\"),\n      sectionCount: document.querySelector(\"#sectionCount\"),\n      sectionNav: document.querySelector(\"#sectionNav\"),\n      dashboardSections: document.querySelector(\"#dashboardSections\")\n    };\n\n    const runtime = {\n      baseUrl: \"\",\n      controllers: new Set(),\n      cleanups: new Set()\n    };\n\n    const formatters = {\n      moeda: new Intl.NumberFormat(\"pt-BR\", {\n        style: \"currency\",\n        currency: \"BRL\"\n      }),\n      numero: new Intl.NumberFormat(\"pt-BR\"),\n      data: new Intl.DateTimeFormat(\"pt-BR\")\n    };\n\n    function normalizarBaseUrl(value) {\n      return String(value || \"\").trim().replace(/\\/+$/, \"\");\n    }\n\n    function setStatus(state, text) {\n      elements.connectionStatus.dataset.state = state;\n      elements.connectionText.textContent = text;\n    }\n\n    function setFeedback(message = \"\", type = \"\") {\n      elements.feedback.textContent = message;\n      elements.feedback.className = `feedback ${type}`.trim();\n    }\n\n    function setLoading(isLoading) {\n      elements.loadButton.disabled = isLoading;\n      elements.reloadButton.disabled = isLoading;\n      elements.loadButton.textContent = isLoading\n        ? \"Carregando...\"\n        : \"Carregar dashboard\";\n    }\n\n    async function requestJson(path, payload = {}) {\n      if (!runtime.baseUrl) {\n        throw new Error(\"O dashboard não foi configurado.\");\n      }\n\n      const controller = new AbortController();\n      runtime.controllers.add(controller);\n\n      try {\n        let response;\n\n        try {\n          response = await fetch(`${runtime.baseUrl}${path}`, {\n            method: \"POST\",\n            headers: {\n              \"Content-Type\": \"application/json\"\n            },\n            body: JSON.stringify(payload),\n            signal: controller.signal\n          });\n        } catch (error) {\n          if (error?.name === \"AbortError\") {\n            throw error;\n          }\n\n          throw new Error(\n            `Não foi possível acessar ${path}. Confirme se o workflow correspondente está ativo no n8n.`\n          );\n        }\n\n        const raw = await response.text();\n        let result;\n\n        try {\n          result = raw ? JSON.parse(raw) : {};\n        } catch {\n          throw new Error(\"A API retornou uma resposta que não é JSON.\");\n        }\n\n        if (!response.ok || result.sucesso === false) {\n          throw new Error(\n            result.erro ||\n            `Falha na API: HTTP ${response.status}.`\n          );\n        }\n\n        return result;\n      } finally {\n        runtime.controllers.delete(controller);\n      }\n    }\n\n    window.DashboardAPI = Object.freeze({\n      consultar: async (payload) => {\n        const result = await requestJson(\n          \"/webhook/dashboard_dados\",\n          payload\n        );\n\n        if (!Array.isArray(result.dados)) {\n          throw new Error(\"A API de dados não retornou o array dados.\");\n        }\n\n        return result.dados;\n      },\n      formatarMoeda: (value) =>\n        formatters.moeda.format(Number(value) || 0),\n      formatarNumero: (value) =>\n        formatters.numero.format(Number(value) || 0),\n      formatarData: (value) => {\n        const date = new Date(value);\n        return Number.isNaN(date.getTime())\n          ? \"-\"\n          : formatters.data.format(date);\n      },\n      registrarCleanup: (callback) => {\n        if (typeof callback !== \"function\") {\n          throw new TypeError(\"O cleanup precisa ser uma função.\");\n        }\n\n        runtime.cleanups.add(callback);\n        return () => runtime.cleanups.delete(callback);\n      }\n    });\n\n    async function carregarDashboard() {\n      const baseUrl = normalizarBaseUrl(elements.n8nBaseUrl.value);\n\n      if (!baseUrl) {\n        setFeedback(\"Informe a URL base do n8n.\", \"error\");\n        return;\n      }\n\n      for (const controller of runtime.controllers) {\n        controller.abort();\n      }\n      runtime.controllers.clear();\n      executarCleanups();\n\n      runtime.baseUrl = baseUrl;\n\n      setLoading(true);\n      setStatus(\"idle\", \"Buscando seções\");\n      setFeedback(\"\");\n\n      try {\n        const result = await requestJson(\n          \"/webhook/dashboard/sections\"\n        );\n\n        const sections = normalizarRespostaSections(\n          result\n        );\n\n        renderSections(sections);\n        setStatus(\"online\", \"Dashboard atualizado\");\n        setFeedback(\n          `${sections.length} seção(ões) carregada(s).`,\n          \"success\"\n        );\n      } catch (error) {\n        renderLoadError(error);\n        setStatus(\"error\", \"Falha ao carregar\");\n        setFeedback(\n          error.message || \"Não foi possível carregar o dashboard.\",\n          \"error\"\n        );\n      } finally {\n        setLoading(false);\n      }\n    }\n\n    function normalizarRespostaSections(result) {\n      const envelopes = Array.isArray(result)\n        ? result\n        : [result];\n\n      const sections = [];\n\n      for (const envelopeOriginal of envelopes) {\n        const envelope = desembrulharJson(\n          envelopeOriginal\n        );\n\n        if (!envelope || typeof envelope !== \"object\") {\n          continue;\n        }\n\n        const registros =\n          envelope.secoes ??\n          envelope.sections ??\n          envelope.dados ??\n          [];\n\n        const lista = Array.isArray(registros)\n          ? registros\n          : [registros];\n\n        for (const registroOriginal of lista) {\n          const registro = desembrulharJson(\n            registroOriginal\n          );\n\n          if (\n            !registro ||\n            typeof registro !== \"object\" ||\n            Array.isArray(registro)\n          ) {\n            continue;\n          }\n\n          const id = String(registro.id ?? \"\").trim();\n          const nome = String(registro.nome ?? \"\").trim();\n          const conteudo = String(\n            registro.conteudo ?? \"\"\n          ).trim();\n\n          if (!id || !nome || !conteudo) {\n            console.warn(\n              \"Seção ignorada por dados obrigatórios ausentes:\",\n              registro\n            );\n            continue;\n          }\n\n          sections.push({\n            id,\n            nome,\n            descricao: String(\n              registro.descricao ?? \"\"\n            ).trim(),\n            conteudo\n          });\n        }\n      }\n\n      return sections;\n    }\n\n    function desembrulharJson(value) {\n      let current = value;\n      let depth = 0;\n\n      while (\n        depth < 4 &&\n        current &&\n        typeof current === \"object\" &&\n        !Array.isArray(current) &&\n        current.json &&\n        typeof current.json === \"object\"\n      ) {\n        current = current.json;\n        depth++;\n      }\n\n      return current;\n    }\n\n    function renderSections(sections) {\n      elements.sectionNav.replaceChildren();\n      elements.dashboardSections.replaceChildren();\n      elements.sectionCount.textContent =\n        `${sections.length} seção(ões) encontrada(s)`;\n\n      if (!sections.length) {\n        const empty = createStateBox(\n          \"Nenhuma seção cadastrada\",\n          \"Adicione registros na tabela analise_dados.dashboard_html.\"\n        );\n        elements.sectionNav.append(\n          createStateBox(\"Sem seções\", \"A tabela está vazia.\")\n        );\n        elements.dashboardSections.append(empty);\n        return;\n      }\n\n      for (const sectionRecord of sections) {\n        const frameId = `dashboard-section-${sectionRecord.id}`;\n        const navigation = document.createElement(\"button\");\n        navigation.type = \"button\";\n        navigation.className = \"section-link\";\n\n        const navigationTitle = document.createElement(\"strong\");\n        navigationTitle.textContent =\n          sectionRecord.nome || `Seção ${sectionRecord.id}`;\n\n        const navigationDescription = document.createElement(\"span\");\n        navigationDescription.textContent =\n          sectionRecord.descricao || \"Sem descrição\";\n\n        navigation.append(\n          navigationTitle,\n          navigationDescription\n        );\n        navigation.addEventListener(\"click\", () => {\n          document.getElementById(frameId)?.scrollIntoView({\n            behavior: \"smooth\",\n            block: \"start\"\n          });\n        });\n\n        const frame = document.createElement(\"article\");\n        frame.className = \"section-frame\";\n        frame.id = frameId;\n\n        const header = document.createElement(\"header\");\n        header.className = \"section-frame-header\";\n\n        const title = document.createElement(\"h2\");\n        title.textContent =\n          sectionRecord.nome || `Seção ${sectionRecord.id}`;\n\n        const description = document.createElement(\"p\");\n        description.textContent =\n          sectionRecord.descricao || \"Seção dinâmica\";\n\n        const content = document.createElement(\"div\");\n        content.className = \"section-frame-content\";\n\n        header.append(title, description);\n        frame.append(header, content);\n\n        elements.sectionNav.append(navigation);\n        elements.dashboardSections.append(frame);\n\n        mountTrustedSection(content, sectionRecord);\n      }\n    }\n\n    function executarCleanups() {\n      for (const cleanup of runtime.cleanups) {\n        try {\n          cleanup();\n        } catch (error) {\n          console.error(\"Falha ao limpar uma seção:\", error);\n        }\n      }\n\n      runtime.cleanups.clear();\n    }\n\n    function mountTrustedSection(container, record) {\n      const html = String(record.conteudo || \"\").trim();\n\n      if (!html) {\n        container.append(\n          createStateBox(\n            \"Seção sem conteúdo\",\n            `O registro ${record.id} não possui HTML.`\n          )\n        );\n        return;\n      }\n\n      const template = document.createElement(\"template\");\n      template.innerHTML = html;\n\n      const rootSections = Array.from(\n        template.content.children\n      ).filter((element) =>\n        element.tagName.toLowerCase() === \"section\"\n      );\n\n      if (rootSections.length !== 1) {\n        container.append(\n          createStateBox(\n            \"Conteúdo inválido\",\n            \"O campo conteudo deve possuir exatamente uma <section> raiz.\"\n          )\n        );\n        return;\n      }\n\n      const scripts = Array.from(\n        template.content.querySelectorAll(\"script\")\n      );\n\n      for (const oldScript of scripts) {\n        oldScript.remove();\n      }\n\n      container.append(template.content);\n\n      for (const oldScript of scripts) {\n        const script = document.createElement(\"script\");\n        script.async = false;\n\n        for (const attribute of oldScript.attributes) {\n          script.setAttribute(attribute.name, attribute.value);\n        }\n\n        script.textContent = oldScript.textContent;\n        container.append(script);\n      }\n    }\n\n    function createStateBox(title, description) {\n      const box = document.createElement(\"div\");\n      box.className = \"state-box\";\n\n      const strong = document.createElement(\"strong\");\n      strong.textContent = title;\n\n      const text = document.createTextNode(description);\n      box.append(strong, text);\n\n      return box;\n    }\n\n    function renderLoadError(error) {\n      elements.sectionNav.replaceChildren(\n        createStateBox(\"Falha\", \"As seções não foram carregadas.\")\n      );\n      elements.dashboardSections.replaceChildren(\n        createStateBox(\n          \"Não foi possível carregar o dashboard\",\n          error.message || \"Verifique a configuração.\"\n        )\n      );\n      elements.sectionCount.textContent = \"Falha no carregamento\";\n    }\n\n    elements.loadButton.addEventListener(\n      \"click\",\n      carregarDashboard\n    );\n    elements.reloadButton.addEventListener(\n      \"click\",\n      carregarDashboard\n    );\n  </script>\n</body>\n</html>\n",
