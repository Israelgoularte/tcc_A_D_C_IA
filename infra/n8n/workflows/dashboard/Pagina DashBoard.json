    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Dashboard de análise</title>\n  <style>\n    :root {\n      font-family: Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif;\n      color: #17211e;\n      background: #f1f5f3;\n      --surface: #ffffff;\n      --surface-soft: #f7faf9;\n      --border: #d9e3df;\n      --muted: #63716d;\n      --primary: #087f68;\n      --header: #103f37;\n      --accent: #ec8b2c;\n      --danger: #b42318;\n      --shadow: 0 8px 24px rgba(20, 32, 29, 0.08);\n    }\n\n    * { box-sizing: border-box; }\n    body { min-width: 320px; min-height: 100vh; margin: 0; background: #f1f5f3; }\n    button { font: inherit; cursor: pointer; }\n\n    .app-header {\n      position: sticky;\n      top: 0;\n      z-index: 10;\n      color: #fff;\n      background: var(--header);\n      border-bottom: 4px solid var(--accent);\n      box-shadow: 0 4px 14px rgba(20, 32, 29, 0.18);\n    }\n\n    .header-inner,\n    .page {\n      width: min(1280px, calc(100% - 32px));\n      margin: 0 auto;\n    }\n\n    .header-inner {\n      min-height: 72px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 16px;\n    }\n\n    h1 { margin: 0; font-size: 1.2rem; }\n    .subtitle { margin: 4px 0 0; color: #cfe1dc; font-size: 0.8rem; }\n\n    .header-actions { display: flex; align-items: center; gap: 12px; }\n    .status { color: #d9ebe6; font-size: 0.82rem; }\n\n    .reload {\n      width: 38px;\n      height: 38px;\n      color: #fff;\n      background: rgba(255, 255, 255, 0.1);\n      border: 1px solid rgba(255, 255, 255, 0.22);\n      border-radius: 6px;\n    }\n\n    .reload:hover { background: rgba(255, 255, 255, 0.18); }\n    .reload:disabled { opacity: 0.55; cursor: wait; }\n\n    .page { padding: 24px 0 48px; }\n    .feedback { min-height: 24px; color: var(--muted); font-size: 0.85rem; }\n    .feedback.error { color: var(--danger); }\n\n    .dashboard { display: grid; gap: 22px; }\n\n    .section {\n      padding: 20px;\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      box-shadow: var(--shadow);\n    }\n\n    .section-header { margin-bottom: 16px; }\n    .section-header h2 { margin: 0; font-size: 1rem; }\n    .section-header p { margin: 5px 0 0; color: var(--muted); font-size: 0.8rem; }\n\n    .component-grid {\n      display: grid;\n      grid-template-columns: repeat(12, minmax(0, 1fr));\n      gap: 14px;\n    }\n\n    .component {\n      grid-column: span var(--span, 6);\n      min-width: 0;\n      padding: 16px;\n      background: var(--surface-soft);\n      border: 1px solid var(--border);\n      border-radius: 7px;\n    }\n\n    .component h3 { margin: 0 0 12px; font-size: 0.88rem; }\n    .component-subtitle { margin: -7px 0 12px; color: var(--muted); font-size: 0.74rem; }\n    .component-state { padding: 18px 0; color: var(--muted); font-size: 0.82rem; }\n    .component-state.error { color: var(--danger); }\n\n    .kpi-value { margin: 4px 0; font-size: 2rem; font-weight: 750; line-height: 1; }\n    .kpi-detail { margin-top: 8px; color: var(--muted); font-size: 0.75rem; }\n\n    .table-wrap { overflow-x: auto; }\n    table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }\n    th, td { padding: 9px 10px; text-align: left; border-bottom: 1px solid var(--border); }\n    th { color: var(--muted); font-size: 0.72rem; font-weight: 700; }\n\n    .bars { display: grid; gap: 10px; }\n    .bar-row { display: grid; grid-template-columns: minmax(110px, 0.8fr) 2fr auto; gap: 10px; align-items: center; }\n    .bar-label { overflow: hidden; font-size: 0.76rem; text-overflow: ellipsis; white-space: nowrap; }\n    .bar-track { height: 9px; overflow: hidden; background: #dfe9e6; border-radius: 4px; }\n    .bar-fill { height: 100%; background: var(--primary); border-radius: 4px; }\n    .bar-value { min-width: 58px; text-align: right; font-size: 0.76rem; font-weight: 700; }\n\n    .empty {\n      padding: 54px 24px;\n      color: var(--muted);\n      text-align: center;\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n    }\n\n    @media (max-width: 900px) {\n      .component { grid-column: span 12 !important; }\n    }\n\n    @media (max-width: 600px) {\n      .header-inner, .page { width: min(100% - 20px, 1280px); }\n      .status { display: none; }\n      .section { padding: 14px; }\n      .bar-row { grid-template-columns: 90px 1fr auto; }\n    }\n  </style>\n</head>\n<body>\n  <header class=\"app-header\">\n    <div class=\"header-inner\">\n      <div>\n        <h1>Dashboard de análise</h1>\n        <p class=\"subtitle\">Indicadores dinâmicos do CRM</p>\n      </div>\n      <div class=\"header-actions\">\n        <span class=\"status\" id=\"status\">Carregando configurações...</span>\n        <button class=\"reload\" id=\"reload\" type=\"button\" aria-label=\"Atualizar dashboard\" title=\"Atualizar dashboard\">↻</button>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"page\">\n    <div class=\"feedback\" id=\"feedback\" role=\"status\" aria-live=\"polite\"></div>\n    <div class=\"dashboard\" id=\"dashboard\"></div>\n  </main>\n\n  <script>\n    \"use strict\";\n\n    const endpoints = {\n      sections: \"/webhook/dashboard/sections\",\n      data: \"/webhook/dashboard_dados\"\n    };\n\n    const elements = {\n      dashboard: document.querySelector(\"#dashboard\"),\n      feedback: document.querySelector(\"#feedback\"),\n      reload: document.querySelector(\"#reload\"),\n      status: document.querySelector(\"#status\")\n    };\n\n    const formatters = {\n      numero: new Intl.NumberFormat(\"pt-BR\"),\n      moeda: new Intl.NumberFormat(\"pt-BR\", { style: \"currency\", currency: \"BRL\" }),\n      percentual: new Intl.NumberFormat(\"pt-BR\", { style: \"percent\", maximumFractionDigits: 1 }),\n      data: new Intl.DateTimeFormat(\"pt-BR\")\n    };\n\n    async function request(path, payload = {}) {\n      const response = await fetch(path, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(payload)\n      });\n\n      const result = await response.json().catch(() => {\n        throw new Error(\"A API retornou uma resposta inválida.\");\n      });\n\n      if (!response.ok || result.sucesso === false) {\n        throw new Error(result.erro || `Falha HTTP ${response.status}.`);\n      }\n\n      return result;\n    }\n\n    function formatValue(value, format = \"texto\") {\n      if (value === null || value === undefined || value === \"\") return \"-\";\n      if (format === \"numero\") return formatters.numero.format(Number(value) || 0);\n      if (format === \"moeda\") return formatters.moeda.format(Number(value) || 0);\n      if (format === \"percentual\") return formatters.percentual.format(Number(value) || 0);\n      if (format === \"data\") {\n        const date = new Date(value);\n        return Number.isNaN(date.getTime()) ? \"-\" : formatters.data.format(date);\n      }\n      return String(value);\n    }\n\n    function element(tag, className, text) {\n      const node = document.createElement(tag);\n      if (className) node.className = className;\n      if (text !== undefined) node.textContent = text;\n      return node;\n    }\n\n    function renderState(container, message, isError = false) {\n      container.replaceChildren(element(\"div\", `component-state${isError ? \" error\" : \"\"}`, message));\n    }\n\n    async function loadComponent(definition, container) {\n      renderState(container, \"Carregando dados...\");\n\n      try {\n        const response = await request(endpoints.data, {\n          identificador: definition.id,\n          consulta: definition.consulta\n        });\n        const rows = Array.isArray(response.dados) ? response.dados : [];\n\n        if (!rows.length) {\n          renderState(container, definition.mensagem_vazio || \"Nenhum dado encontrado.\");\n          return;\n        }\n\n        if (definition.tipo === \"kpi\") renderKpi(definition, rows, container);\n        else if (definition.tipo === \"tabela\") renderTable(definition, rows, container);\n        else if (definition.tipo === \"barras\") renderBars(definition, rows, container);\n        else renderState(container, `Tipo de componente não suportado: ${definition.tipo}`, true);\n      } catch (error) {\n        renderState(container, error.message || \"Erro ao carregar dados.\", true);\n      }\n    }\n\n    function renderKpi(definition, rows, container) {\n      const value = rows[0]?.[definition.campo_valor];\n      container.replaceChildren(\n        element(\"div\", \"kpi-value\", formatValue(value, definition.formato)),\n        element(\"div\", \"kpi-detail\", definition.detalhe || \"\")\n      );\n    }\n\n    function renderTable(definition, rows, container) {\n      const columns = Array.isArray(definition.colunas) ? definition.colunas : [];\n      const table = document.createElement(\"table\");\n      const head = document.createElement(\"thead\");\n      const headRow = document.createElement(\"tr\");\n      const body = document.createElement(\"tbody\");\n\n      for (const column of columns) {\n        headRow.append(element(\"th\", \"\", column.titulo || column.campo));\n      }\n\n      for (const row of rows) {\n        const tr = document.createElement(\"tr\");\n        for (const column of columns) {\n          tr.append(element(\"td\", \"\", formatValue(row[column.campo], column.formato)));\n        }\n        body.append(tr);\n      }\n\n      head.append(headRow);\n      table.append(head, body);\n      const wrap = element(\"div\", \"table-wrap\");\n      wrap.append(table);\n      container.replaceChildren(wrap);\n    }\n\n    function renderBars(definition, rows, container) {\n      const values = rows.map((row) => Number(row[definition.campo_valor]) || 0);\n      const max = Math.max(...values, 1);\n      const bars = element(\"div\", \"bars\");\n\n      rows.forEach((row, index) => {\n        const line = element(\"div\", \"bar-row\");\n        const label = element(\"div\", \"bar-label\", formatValue(row[definition.campo_categoria]));\n        const track = element(\"div\", \"bar-track\");\n        const fill = element(\"div\", \"bar-fill\");\n        const value = element(\"div\", \"bar-value\", formatValue(values[index], definition.formato));\n        fill.style.width = `${Math.max(2, (values[index] / max) * 100)}%`;\n        track.append(fill);\n        line.append(label, track, value);\n        bars.append(line);\n      });\n\n      container.replaceChildren(bars);\n    }\n\n    function renderSection(section) {\n      const wrapper = element(\"section\", \"section\");\n      const header = element(\"header\", \"section-header\");\n      header.append(\n        element(\"h2\", \"\", section.nome),\n        element(\"p\", \"\", section.descricao || \"\")\n      );\n\n      const grid = element(\"div\", \"component-grid\");\n      wrapper.append(header, grid);\n\n      for (const component of section.componentes) {\n        const card = element(\"article\", \"component\");\n        const content = element(\"div\", \"component-content\");\n        const span = Math.min(12, Math.max(3, Number(component.largura) || 6));\n        card.style.setProperty(\"--span\", span);\n        card.append(element(\"h3\", \"\", component.titulo || component.id));\n        if (component.subtitulo) {\n          card.append(element(\"p\", \"component-subtitle\", component.subtitulo));\n        }\n        card.append(content);\n        grid.append(card);\n        loadComponent(component, content);\n      }\n\n      return wrapper;\n    }\n\n    async function loadDashboard() {\n      elements.reload.disabled = true;\n      elements.feedback.textContent = \"\";\n      elements.feedback.className = \"feedback\";\n      elements.status.textContent = \"Carregando configurações...\";\n      elements.dashboard.replaceChildren();\n\n      try {\n        const response = await request(endpoints.sections);\n        const sections = Array.isArray(response.secoes) ? response.secoes : [];\n\n        if (!sections.length) {\n          elements.dashboard.append(element(\"div\", \"empty\", \"Nenhuma seção válida foi cadastrada.\"));\n        } else {\n          for (const section of sections) {\n            elements.dashboard.append(renderSection(section));\n          }\n        }\n\n        if (Array.isArray(response.erros) && response.erros.length) {\n          elements.feedback.textContent = `${response.erros.length} seção(ões) foram ignoradas por configuração inválida.`;\n          elements.feedback.className = \"feedback error\";\n        }\n\n        elements.status.textContent = `${sections.length} seção(ões) carregada(s)`;\n      } catch (error) {\n        elements.dashboard.append(element(\"div\", \"empty\", \"Não foi possível carregar o dashboard.\"));\n        elements.feedback.textContent = error.message || \"Falha no carregamento.\";\n        elements.feedback.className = \"feedback error\";\n        elements.status.textContent = \"Falha ao carregar\";\n      } finally {\n        elements.reload.disabled = false;\n      }\n    }\n\n    elements.reload.addEventListener(\"click\", loadDashboard);\n    loadDashboard();\n  </script>\n</body>\n</html>\n",
