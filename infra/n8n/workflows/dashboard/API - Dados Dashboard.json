        "jsCode": "const requisicao = $input.first().json ?? {};\nconst body = requisicao.body ?? requisicao;\n\nconst consulta = body.consulta && typeof body.consulta === 'object'\n  ? body.consulta\n  : body;\n\nconst serializarArray = (valor) => {\n  if (valor === undefined || valor === null || valor === '') return '[]';\n  return typeof valor === 'string' ? valor : JSON.stringify(valor);\n};\n\nreturn [{\n  json: {\n    operacao: String(consulta.operacao || 'listar'),\n    entidade: String(consulta.entidade || ''),\n    campos: serializarArray(consulta.campos),\n    filtros: serializarArray(consulta.filtros),\n    agrupar_por: serializarArray(consulta.agrupar_por),\n    metricas: serializarArray(consulta.metricas),\n    ordenacao: serializarArray(consulta.ordenacao),\n    limite: Number(consulta.limite || 50)\n  }\n}];"
