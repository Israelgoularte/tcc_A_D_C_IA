# Copie para .env e escolha local ou ssh.
EXECUTION_MODE=local

# Obrigatorios no modo ssh.
SSH_HOST=192.0.2.10
SSH_USER=root
SSH_PORT=22

# Opcional. Requer sshpass instalado na maquina de origem.
# Nunca versione o arquivo scripts/.env preenchido.
SSH_PASSWORD=

# Alternativa recomendada para ambientes reais.
# Vazio permite usar SSH_PASSWORD, ssh-agent ou as chaves padrao.
SSH_PRIVATE_KEY=

# accept-new cadastra hosts novos e rejeita chaves alteradas.
# Use true quando a chave ja estiver previamente cadastrada.
# Use false somente em ambientes descartaveis e controlados.
SSH_STRICT_HOST_KEY_CHECKING=accept-new

# Caminho relativo ao diretorio pessoal do usuario remoto.
REMOTE_PATH=n8n-stack
